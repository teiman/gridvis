# ---------------------------------------------------------------------------
# Build output
# ---------------------------------------------------------------------------
# build.bat folder and downloaded Embree/TBB (see testing.md)
ericw-tools/build-windows/
ericw-tools/deps/
# Any other CMake build folder (VS Code CMake Tools defaults to build/ in the root)
build/
build-*/
out/
cmake-build-*/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
CMakeUserPresets.json
CMakeSettings.json

# Compiled binaries, debug symbols and intermediates
*.exe
# ...except the QuakeC compiler used by mod\build.bat
!mod/bin/fteqcc64.exe
*.dll
*.pdb
*.ilk
*.exp
*.obj
*.idb
*.iobj
*.ipdb
*.tlog
*.lastbuildstate
# GPU shaders compiled from light/shaders/*.comp
*.spv

# Distribution packages (dist.bat)
dist/
*.zip
*.7z

# ---------------------------------------------------------------------------
# Map compiler output (qbsp / vis / light / bsputil), anywhere in the tree
# ---------------------------------------------------------------------------
*.bsp
*.lit
*.lux
*.prt
*.pts
*.lin
*.vis
*.texinfo
*.texinfo.json
*.content.json
*.qbsplog
*.log
*-decompile*.map
*.chop.map
# ...except the precompiled BSPs that ship with ericw-tools' tests
!ericw-tools/testmaps/compiled/*.bsp

# ---------------------------------------------------------------------------
# Output of the test scripts in the root
# ---------------------------------------------------------------------------
# Per-run tool output (compile.bat, build.bat, moduild.bat)
*_last.txt
# tools/bench.py appends to this on every run; keep it local
testmap/bench_history.txt
# Generated by tools/makemap.py (compile.bat)
testmap/gridtest.map
# Compiled QuakeC, demos
mod/progs.dat
mod/progs.lno
*.dem

# Third-party texture WADs (not redistributable; see testing.md)
*.wad
# ...except the test WADs that ship with ericw-tools
!ericw-tools/testmaps/**/*.wad

# Map editor backups (TrenchBroom, J.A.C.K., ...)
autosave/
*.bak
*.autosave.map

# ---------------------------------------------------------------------------
# Tools, editors, OS
# ---------------------------------------------------------------------------
# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Visual Studio / VS Code / other IDEs
.vs/
*.user
*.suo
*.VC.db
*.VC.opendb
ipch/
.vscode/*
!.vscode/settings.json
.idea/
.claude/settings.local.json

# Temporary files, merge leftovers
*.tmp
*.temp
*.orig
*.rej
*.swp
*~

# OS
Thumbs.db
desktop.ini
.DS_Store

# Fluxite suggestions
.claude/
.cursor/
.vscode/
*$py.class
*.so
.env
*.egg-info/
progs.dat
progs.lno
*.pak
